"$schema" = 'https://starship.rs/config-schema.json'

format = """
$cmd_duration\
[](color_red)\
$os\
$username\
$hostname\
[](bg:color_orange fg:color_red)\
$directory\
[](fg:color_orange bg:color_yellow)\
$git_branch\
$git_status\
[](fg:color_yellow bg:color_aqua)\
$c\
$rust\
$golang\
$ruby\
$php\
$java\
$kotlin\
$haskell\
$python\
[](fg:color_aqua bg:color_blue)\
[](fg:color_blue bg:color_purple)\
[ ](fg:color_purple)\
$line_break$character"""

palette = 'monokai_pro'

[palettes.monokai_pro]
color_fg0 = '#221f22'
color_bg1 = '#353136'
color_bg3 = '#403e41'
color_blue = '#78dce8'
color_aqua = '#a9dc76'
color_green = '#a9dc76'
color_orange = '#fc9867'
color_purple = '#ab9df2'
color_red = '#ff6188'
color_yellow = '#ffd866'

[cmd_duration]
style = "bg:color_purple fg:color_fg0"
format = "[](color_purple)[ ◷ $duration]($style)[](color_purple)\n"

[os]
disabled = false
style = "bg:color_red fg:color_fg0"
format = '[$symbol ]($style)'

[os.symbols]
Windows = "󰍲"
Ubuntu = "󰕈"
SUSE = ""
Raspbian = "󰐿"
Mint = "󰣭"
Macos = "󰀵"
Manjaro = ""
Linux = "󰌽"
Gentoo = "󰣨"
Fedora = "󰣛"
Alpine = ""
Amazon = ""
Android = ""
Arch = "󰣇"
Artix = "󰣇"
CentOS = ""
Debian = "󰣚"
Redhat = "󱄛"
RedHatEnterprise = "󱄛"

[username]
show_always = false
style_user = "bg:color_red fg:color_fg0"
style_root = "bg:color_red fg:color_fg0"
format = '[ $user ]($style)'

[hostname]
ssh_only = true
ssh_symbol = " "
style = "bg:color_red fg:color_fg0"
format = '[$ssh_symbol$hostname]($style)'

[directory]
style = "fg:color_fg0 bg:color_orange"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = "󰝚 "
"Pictures" = " "
"Developer" = "󰲋 "

[git_branch]
symbol = ""
style = "bg:color_yellow"
format = '[[ $symbol $branch ](fg:color_fg0 bg:color_yellow)]($style)'

[git_status]
style = "bg:color_yellow"
format = '[[($all_status$ahead_behind )](fg:color_fg0 bg:color_yellow)]($style)'
conflicted = '[!$count](fg:red bg:color_yellow)'
untracked = '?$count'
modified = '[*$count](fg:red bg:color_yellow)'
staged = '[+$count](fg:green bg:color_yellow)'
ahead = '⇡${count}'
diverged = '⇕⇡${ahead_count}⇣${behind_count}'
behind = '⇣${count}'

[nodejs]
symbol = ""
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[c]
symbol = " "
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[rust]
symbol = ""
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[golang]
symbol = ""
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[php]
symbol = ""
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[java]
symbol = " "
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[kotlin]
symbol = ""
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[haskell]
symbol = ""
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[python]
symbol = ""
style = "bg:color_aqua"
format = '[[ $symbol( $version) ](fg:color_fg0 bg:color_aqua)]($style)'

[ruby]
symbol = "🍒"
style = "bg:color_aqua"
format = '[[ $symbol($version) ](fg:color_fg0 bg:color_aqua)]($style)'

[docker_context]
symbol = ""
style = "bg:color_bg3"
format = '[[ $symbol( $context) ](fg:color_aqua bg:color_blue)]($style)'

[time]
disabled = false
time_format = "%R"
style = "bg:color_bg1"
format = '[[  $time ](fg:color_fg0 bg:color_bg1)]($style)'

[line_break]
disabled = false

[character]
disabled = false
success_symbol = '[»](bold fg:color_green)'
error_symbol = '[»](bold fg:color_red)'
vimcmd_symbol = '[«](bold fg:color_green)'
vimcmd_replace_one_symbol = '[«](bold fg:color_purple)'
vimcmd_replace_symbol = '[«](bold fg:color_purple)'
vimcmd_visual_symbol = '[«](bold fg:color_yellow)'
